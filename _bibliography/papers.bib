@article{f.s:2026b,
  title={Hardware-Efficient Neural Architecture Search for Wireless Signal Classification on Edge Devices},
  abbr={SMACD},
  author={Suárez Bonilla, Félix David and
          De-la-Rosa, José M and
          Liñán-Cembrano, Gustavo},
  year={2026},
  journal={2026 International Conference on Synthesis, Modeling, Analysis and Simulation Methods and Applications to Circuit Design},
  month={June},
  abstract={This paper presents an evolutionary Neural Architecture
Search (NAS) methodology for hardware-efficient wireless
signal classification on edge devices. The updated NAS configuration
discovered an ultra-compact model with 3,539 parameters
that classifies LTE, DVB-T, and WiFi signals with 90.1% test
accuracy on real-world over-the-air data. The inference was
implemented in an iOS application and tested on actual iPhone
hardware.},
    keywords={Neural Architecture Search, Wireless Signal
Classification, Edge Computing, Hardware-Efficient Deep Learning,
Core ML, Embedded Systems, LTE, DVB-T, WiFi},
  preview={radio_wave.gif},
  selected={true},
}

@article{f.s:2026a,
  title={Neural Architecture Search for Efficient WiFi Spectrum Sensing},
  abbr={NASpectrum},
  author={Suárez Bonilla, Félix David and
          De-la-Rosa, José M and
          Liñán-Cembrano, Gustavo},
  year={2026},
  journal={2026 IEEE International Conference on Machine Learning for Communication and Networking (ICMLCN)},
  month={June},
  abstract={The explosive growth of wireless devices has intensified
the demand for efficient spectrum management solutions. This
work addresses this challenge through Neural Architecture Search
(NAS) applied to WiFi spectrum sensing, using 320,000 real IQ
signals from the DeepSense dataset. Our approach discovered
an ultra-efficient architecture with just 13,412 parameters that
achieves 98.4% classification accuracy—a 92.7% reduction in
model complexity compared to a baseline with 184,000 parameters
and 96.6% accuracy. When deployed on an iPhone 17 Pro Max, the
model performs remarkably well with 0.12 ms inference latency
and 98.0% accuracy, processing over 8,500 signals per second. This
represents a 121-fold speedup compared to training conditions
and outperforms even specialized FPGA implementations.},
  keywords={Neural Architecture Search, Spectrum Sensing,
Deep Learning, WiFi 802.11, IQ Signals, Model Optimization,
Cognitive Radio, Mobile Deployment},
  preview={wifi_sensing.gif},
  selected={true},
}

@article{f.s:2025b,
  title={SQL Server Optimization: Configuration-Based Performance Improvements},
  abbr={SQLOpt},
  author={
    Suárez Bonilla, Félix David and
    Pineda, T. and
    Castro, E. and
    Olmos, D. and
    Tello, Daniel.
  },
  year={2025},
  journal={2025 Computing, Communications and IoT Applications (ComComAp)}, 
  month={December},
  abstract={This study presents a comprehensive investigation into optimizing a SQL Server in a business production environment that was experiencing severe performance problems and frequent system freezing. We implemented a systematic methodology consisting of three key phases: thorough diagnosis, strategic optimization, and longitudinal monitoring. Our findings demonstrate statistically significant improvements across critical performance indicators, including a 26% reduction in CPU utilization, a 4.3% increase in available memory, stabilization of the Page Life Expectancy indicator at optimal values exceeding 300 seconds, and complete elimination of system freezing episodes. This research provides a transferable methodological framework for SQL Server optimization across diverse business environments while contributing valuable insights to the efficient management of relational databases in high-availability contexts.},
  keywords={SQL Server, Business Environment, Production Environment, Database Management, Systematic Methodology, Longitudinal Monitoring, CPU Utilization, Best Practices, Operating System, Performance Metrics, Longitudinal Analysis, Maximum Limit, Monitoring Period, Engineering Optimization, Caching, Key Metrics, Proactive Management, Maintenance Planning, Memory Management, Key Performance Metrics, Minimal Memory, Memory Allocation, Relational Database Management System, Execution Plan, Maximum Memory, Query Performance, Data File, Multiple Files},
  preview={sql_server.gif},
  doi = {10.1109/ComComAp68359.2025.11353129},
  selected={true},
}

@article{f.s:2025a,
  title={Neural Architecture Search for Over-the-Air Telecommunication Signal Classification},
  abbr={NASTelecom},
  author={Suárez Bonilla, Félix David and 
          De la Rosa Utrera, José Manuel and
          Liñán-Cembrano, Gustavo},
  year={2025},
  journal={2025 32nd IEEE International Conference on Electronics Circuits and Systems (ICECS)}, 
  month={November},
  abstract={This paper presents a Neural Architecture Search
(NAS) approach for automatic classification of telecommunication
signals using Convolutional Neural Networks (CNNs). Our optimized
CNN architecture achieved 96.29% accuracy using Neural
Architecture Search with only 91,367 trainable parameters,
demonstrating improved computational efficiency compared to
manually designed architectures. We explored 63 million possible
architectural configurations using Bayesian optimization to
systematically identify optimal network designs for spectrogrambased
signal classification. The search process evaluated 20
different trials over approximately 1 hour and 21 minutes,
ultimately discovering an architecture that balances accuracy and
computational efficiency. This work demonstrates how automated
architecture search can effectively optimize telecommunication
signal processing applications for spectrum monitoring, electronic
defense, and cognitive radio systems.},
  keywords={Neural architecture search, signal classification, convolutional neural networks, telecommunication signals, software-defined radio, spectrum monitoring, Bayesian optimization, over-the-air signals},
  preview={nas_telecom.gif},
  doi = {10.1109/ICECS66544.2025.11270591},
  selected={true},
}

@article{f.s:2025,
  title={Multi-Domain Feature Extraction for ML-Based Over-the-Air RF Signal Classification},
  abbr={DCIS},
  author={Suárez Bonilla,
          Félix David and 
          Liñán-Cembrano,
          Gustavo and 
          De la Rosa Utrera,
          José Manuel},
  year={2025},
  journal={40th Conference on Design of Circuits and Integrated Systems (DCIS 2025)},
  month={November},
  day={27},
  publisher={IEEE},
  preview={neural_network.gif},
  abstract = {This paper presents a system for automatic classification of telecommunication signals using signal processing, multi-domain features fusion, and machine learning techniques. Our system achieves a 97.72% classification accuracy across a wide range of SNR values (-20 dB to 18 dB) using an over-the-air radio-frequency (RF) signals dataset, while maintaining a relatively low complexity (167k learnable parameters). We employ a comprehensive feature extraction methodology that combines time-frequency representations, wavelet transform coefficients, and frequency domain statistics which are processed through a multi-layer architecture. This work demonstrates a systematic approach to signal classification that balances accuracy, computational efficiency, and generalization capability, with potential applications in spectrum monitoring, electronic defense, and cognitive radio systems.},
  doi = {10.1109/DCIS67520.2025.11281930},
  selected={true}, 
}


@article{f.s:2021,
  title={BETO Emotion Analysis of Facebook Users Reacting to Major Media Outlets in Costa Rica},
  abbr={TransAI},
  author={Suárez Bonilla,
          Félix and Vargas Oconitrillo,
          Natyari and Garro Castro,
          José David and Durán,
          Alejandro and Jiménez Chavarría,
          Ana Paula},
  year={2021},
  journal={2021 Third International Conference on Transdisciplinary AI},
  month={September},
  publisher={IEEE},
  preview={facebook_article.gif},
  abstract = {An emotion analysis service, based on Transfer Learning, was built using BETO, and applied to Facebook posts written in Spanish. The system was tested using comments related to the anniversary of major media outlets in Costa Rica, the comments on these posts provide insight into the public opinion towards the mentioned media outlet. After collecting the comments and processing them into the emotion analyzer, the most common feelings for each media where: Amelia Rueda (joy), La Nación (anger and sadness) and Teletica.com (joy and anger).},
  doi = {10.1109/TransAI51903.2021.00027},
  selected={true},
}


@article{f.s:2020,
  title={Robotic architecture to map an action language to a low level motion commands for skillful manipulation},
  abbr={ITNEC},
  author={Suárez Bonilla,
          Félix and 
          Federico Ruiz Ugalde},
  year={2020},
  journal={2020 IEEE 4th Information Technology, Networking, Electronic and Automation Control Conference},
  month={June},
  publisher={IEEE},
  preview={robotic_arm.gif},
  abstract = {This paper gives an overview of a robotic architecture meant for skillful manipulation. This design is meant to close the gap between the high-level layer (reasoning and planing layer) and the object model system (physical control layer). This architecture proposes an interface layer that allows, in a meaningful way, to connect atomic tasks with controller inputs. In this paper, we discuss how specific complex tasks can be resolved by this system; we analyze the affordance unit design and, we overview the future challenges in the implemenation of the whole system.},
  doi = {10.1109/ITNEC48623.2020.9084782},
  selected={true},
}



@article{f.s:2019,
  title={Automatic Translation of Spanish Natural Language Commands to Control Robot Commands Based on LSTM Neural Network},
  abbr={IRC},
  author={Suárez Bonilla,
          Félix and 
          Federico Ruiz Ugalde},
  year={2019},
  journal={2019 Third IEEE International Conference on Robotic Computing},
  month={February},
  publisher={IEEE},
  preview={code.gif},
  abstract = {In this paper, we propose a high level layer able to translate motion commands in natural spanish language to a formal intermediate representation called Robot Control Language (RCL). The layer was built by using the seq2seq TensorFlow library, with a single forward LSTM for encoder and decoder respectively. We were able to achieve a 4.3e-08 loss employing a manually generated corpus in Spanish.},
  doi = {10.1109/IRC.2019.00026},
  selected={true},
}

@article{f.s:2018,
  title={Analysis of Atomic Manipulation Tasks in Human-Shared Scenarios for a Humanoid Robot},
  abbr={IWOBI},
  author={Suárez Bonilla,
          Félix and 
          Federico Ruiz Ugalde},
  year={2018},
  journal={2018 IEEE International Work Conference on Bioinspired Intelligence},
  month={July},
  publisher={IEEE},
  preview={digital.gif},
  abstract = {In this paper we analyze the vocabulary of an action description language to be used, together with a low level object controller, by a humanoid robot in two specific scenarios: a kitchen and a collaborative workshop table. A methodology to acquire this knowledge is presented and then it is applied to these two scenarios. The collected data allows to establish a priority of which actions needs to be implemented with robot controllers, which objects need to be manipulated and how much variation they exhibit between different scenarios or different complex tasks.},
  doi = {10.1109/IWOBI.2018.8464220},
  selected={true},
}

